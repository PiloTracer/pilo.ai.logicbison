#!/bin/sh
#
# prepare-commit-msg — strip Co-authored-by trailers; auto-prepend task ref.
#
# Installation:
#   bash scripts/install-git-hooks.sh          (self-hosted)
#   bash .ai/scripts/install-git-hooks.sh      (fat-client)
#   (or @project-bootstrap init / deploy-basic / bootstrap.sh)
#
# See .cursorrules § No Co-authored-by · § Task Refs

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"
SHA1="$3"

strip_co_authored_trailers() {
  _f="$1"
  [ -f "$_f" ] || return 0
  _tmp="$(mktemp)"
  grep -viE '^[[:space:]]*Co-authored-by:[[:space:]]*' "$_f" > "$_tmp" 2>/dev/null || : > "$_tmp"
  mv "$_tmp" "$_f"
}

# Always strip agent/IDE Co-authored-by lines (including git commit --trailer).
strip_co_authored_trailers "$COMMIT_MSG_FILE"

# Only prepend ref on new commits (not template, merge, squash, etc.)
if [ "$COMMIT_SOURCE" = "template" ] || [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
  exit 0
fi

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

REF=$(echo "$BRANCH" | grep -oE '[A-Z][A-Z0-9_]*-(T-)?[0-9]+' | head -1)

if [ -z "$REF" ]; then
    TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
    if [ -n "$TOPLEVEL" ] && [ -f "${TOPLEVEL}/.work/active-ref" ]; then
        REF=$(head -1 "${TOPLEVEL}/.work/active-ref" 2>/dev/null | grep -oE '[A-Z][A-Z0-9_]*-(T-)?[0-9]+' | head -1)
    fi
fi

if [ -n "$REF" ]; then
    SUBJECT=$(head -1 "$COMMIT_MSG_FILE" 2>/dev/null || echo "")
    case "$SUBJECT" in
        "$REF:"*|"$REF: "*) ;;
        *)
            sed -i "1s/^/${REF}: /" "$COMMIT_MSG_FILE" 2>/dev/null || {
                _body="$(tail -n +2 "$COMMIT_MSG_FILE" 2>/dev/null || true)"
                printf '%s: %s\n' "$REF" "$SUBJECT" > "$COMMIT_MSG_FILE"
                [ -n "$_body" ] && printf '%s\n' "$_body" >> "$COMMIT_MSG_FILE"
            }
            ;;
    esac
fi

strip_co_authored_trailers "$COMMIT_MSG_FILE"
